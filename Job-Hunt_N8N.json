      "parameters": {
        "jsCode": "let url = \"https://www.linkedin.com/jobs/search/?f_TPR=r86400&location=Canada\";\n\n// --- Always use DS/DA/ML roles (ignore sheet keyword)\nconst defaultRoles = `(\"data scientist\" OR \"data analyst\" OR \"machine learning engineer\" OR \"ml engineer\")`;\nurl += `&keywords=${encodeURIComponent(defaultRoles)}`;\n\n// --- Experience levels: Internship, Entry, Associate, Mid-Senior only\nurl += \"&f_E=1,2,3,4\";\n\n// --- Optional filters that CAN still come from sheet:\nconst remote    = $input.first().json.Remote     || \"\";\nconst easyApply = ($input.first().json[\"Easy Apply\"] || \"\").toString();\n\nif (remote.trim() !== \"\") {\n  const transformedRemote = remote.split(\",\").map(e => {\n    switch (e.trim().toLowerCase()) {\n      case \"remote\": return \"2\";\n      case \"hybrid\": return \"3\";\n      case \"on-site\":\n      case \"onsite\": return \"1\";\n      default: return \"\";\n    }\n  }).filter(Boolean);\n  if (transformedRemote.length) url += `&f_WT=${transformedRemote.join(\",\")}`;\n}\n\nif (easyApply.trim().toLowerCase() === \"true\") url += \"&f_AL=true\";\n\nreturn { url };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
