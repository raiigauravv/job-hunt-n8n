      ],
      "id": "ab9f617a-abcd-44d6-860e-e7371f76458a",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
